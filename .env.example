# EcoSentry EmailJS Notification Configuration
# Obtain these credentials from your EmailJS dashboard: https://dashboard.emailjs.com/
#
# 1. Service ID: Found under Email Services (e.g. service_gmail, service_outlook, etc.)
VITE_EMAILJS_SERVICE_ID=service_your_service_id

# 2. Template ID: Found under Email Templates (e.g. template_incident_alert)
VITE_EMAILJS_TEMPLATE_ID=template_your_template_id

# 3. Public Key: Found under Account > API Keys > Public Key
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Optional: Default recipient email address if your template defines {{to_email}}
VITE_EMAILJS_TO_EMAIL=operations-command@ecosentry.reserve

# Supabase Authentication & Database Integration
# Obtain these credentials from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
